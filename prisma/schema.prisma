generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  AI_AGENT
  SAAS
  WEB_APP
  MOBILE_APP
  AUTOMATION
  CUSTOM_ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ENTERPRISE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  name          String?
  role          String         @default("user")
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  tagline         String?
  description     String      @db.Text
  longDescription String?     @db.Text
  type            ProductType
  featured        Boolean     @default(false)
  published       Boolean     @default(true)
  imageUrl        String?
  videoUrl        String?
  demoUrl         String?
  gifUrl          String?
  features        Json        @default("[]")
  benefits        Json        @default("[]")
  integrations    Json        @default("[]")
  faqs            Json        @default("[]")
  screenshots     Json        @default("[]")
  architecture    Json?
  workflow        Json?
  roiMetrics      Json?
  order           Int         @default(0)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  pricingPlans    PricingPlan[]
  testimonials    Testimonial[]
  caseStudies     CaseStudy[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
  @@index([type])
  @@index([featured])
}

model PricingPlan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  monthlyPrice    Float?
  yearlyPrice     Float?
  features        Json            @default("[]")
  stripePriceId   String?
  stripeYearlyId  String?
  trialDays       Int             @default(14)
  isEnterprise    Boolean         @default(false)
  isPopular       Boolean         @default(false)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  pricingPlanId        String
  pricingPlan          PricingPlan        @relation(fields: [pricingPlanId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(TRIALING)
  interval             BillingInterval    @default(MONTHLY)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Lead {
  id        String     @id @default(cuid())
  email     String
  name      String?
  company   String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@index([status])
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  role       String
  company    String
  content    String   @db.Text
  avatarUrl  String?
  rating     Int      @default(5)
  featured   Boolean  @default(false)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model CaseStudy {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  client          String
  industry        String
  problem         String   @db.Text
  solution        String   @db.Text
  implementation  String   @db.Text
  results         Json
  revenueIncrease Float?
  costReduction   Float?
  timeSaved       Int?
  imageUrl        String?
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      String   @db.Text
  coverImage   String?
  category     String
  tags         String[]
  author       String
  authorAvatar String?
  readingTime  Int      @default(5)
  published    Boolean  @default(true)
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([published])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  type        String
  fileUrl     String?
  coverImage  String?
  downloadCount Int    @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model DemoRequest {
  id                String        @id @default(cuid())
  company           String
  name              String
  email             String
  phone             String?
  industry          String?
  companySize       String?
  challenges        String?       @db.Text
  productsInterested Json         @default("[]")
  preferredTime     String?
  status            RequestStatus @default(PENDING)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model ContactRequest {
  id          String        @id @default(cuid())
  company     String
  name        String
  email       String
  phone       String?
  industry    String?
  companySize String?
  budget      String?
  timeline    String?
  message     String        @db.Text
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([email])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  page      String?
  metadata  Json?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}
